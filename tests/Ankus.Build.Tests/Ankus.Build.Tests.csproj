<Project Sdk="MSTest.Sdk">
  <ItemGroup>
    <AssemblyMetadata Include="AnkusTestSdkVersion" Value="$(NETCoreSdkVersion)" />
    <AssemblyMetadata Include="AnkusTestSdkDirectory" Value="$(MSBuildToolsPath)" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <ProjectReference Include="..\..\src\Ankus.Build\Ankus.Build.csproj" />
    <ProjectReference Include="..\..\src\Ankus.Runtime\Ankus.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Ankus.Testing\Ankus.Testing.csproj" />
    <None Include="../../src/Ankus.Sdk/Ankus.props" Link="Sdk/Ankus.props" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Ankus.Sdk/targets/Ankus.Bindings.targets" Link="Sdk/Ankus.Bindings.targets" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Ankus.Sdk/targets/Ankus.Development.targets" Link="Sdk/Ankus.Development.targets" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Ankus.Sdk/targets/Ankus.EditorDependency.targets" Link="Sdk/Ankus.EditorDependency.targets" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Ankus.Sdk/targets/Ankus.Native.targets" Link="Sdk/Ankus.Native.targets" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Ankus.Sdk/targets/Ankus.PostgresSelection.targets" Link="Sdk/Ankus.PostgresSelection.targets" CopyToOutputDirectory="PreserveNewest" />
    <!-- The packaged MSBuild SDK layout, imported as Sdk="Ankus.Sdk" consumers import it, beside the repository's
         project-body entry point for the same targets. -->
    <None Include="../../src/Ankus.Sdk/Sdk/Sdk.props;../../src/Ankus.Sdk/Sdk/Sdk.targets" Link="AnkusSdk/Sdk/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Ankus.Sdk/Ankus.props;../../src/Ankus.Sdk/Ankus.Sdk.targets" Link="AnkusSdk/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Ankus.Sdk/targets/*.targets;../../src/Ankus.Sdk/targets/*.props" Link="AnkusSdk/targets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <EnableMSTestSourceGeneration>true</EnableMSTestSourceGeneration>
  </PropertyGroup>
</Project>
