<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <RootNamespace>Ankus.Examples.Hello.Tests</RootNamespace>
    <EnableMSTestSourceGeneration>true</EnableMSTestSourceGeneration>
    <!-- These tests compile against sample extensions, so they follow an acceptance run's retargeting, such as to net11.0. -->
    <TargetFramework Condition="'$(AnkusExtensionTargetFramework)' != ''">$(AnkusExtensionTargetFramework)</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../samples/Ankus.Examples.Hello/Ankus.Examples.Hello.csproj" />
  </ItemGroup>

</Project>
