<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Ankus.PgConfig</RootNamespace>
    <Description>Cross-platform PostgreSQL installation discovery and configuration for Ankus.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- An editor compiles a navigated file on its own, so each file declares its usings and the PDB carries the source. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <EmbedAllSources>true</EmbedAllSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Diagnostics.EventLog" />
  </ItemGroup>

</Project>
