<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Ankus</RootNamespace>
    <Description>Native AOT-compatible PostgreSQL extension APIs for .NET.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- An editor compiles a navigated file on its own, so each file declares its usings and the PDB carries the source. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <EmbedAllSources>true</EmbedAllSources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Formats.Cbor" />
    <InternalsVisibleTo Include="Ankus.Runtime.Tests" />
  </ItemGroup>
</Project>
