using System.Diagnostics;
using Npgsql;

namespace __NAMESPACE__.Tests;

public sealed partial class BackendTests
{
    [TestMethod]
    public async Task WorkerRunsInAnotherPostgresProcess()
    {
        CancellationToken token = context.CancellationToken;
        await using NpgsqlConnection connection = await s_extension!.Cluster.OpenConnectionAsync(token);
        var elapsed = Stopwatch.StartNew();
        while (elapsed.Elapsed < TimeSpan.FromSeconds(30))
        {
            await using var command = new NpgsqlCommand("SELECT worker_process(), worker_result()", connection);
            await using NpgsqlDataReader reader = await command.ExecuteReaderAsync(token);
            Assert.IsTrue(await reader.ReadAsync(token));
            int process = reader.GetInt32(0);
            int result = reader.GetInt32(1);
            if (result == 42)
            {
                Assert.IsGreaterThan(0, process);
                Assert.AreNotEqual(connection.ProcessID, process);
                return;
            }

            await Task.Delay(25, token);
        }

        Assert.Fail("The PostgreSQL worker did not publish its committed query result.");
    }
}
