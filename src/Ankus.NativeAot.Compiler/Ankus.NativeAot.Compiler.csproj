<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Ankus.NativeAot.Compiler</PackageId>
    <PackageId Condition="'$(AnkusCompilerRuntimeIdentifier)' != ''">Ankus.NativeAot.Compiler.$(AnkusCompilerRuntimeIdentifier)</PackageId>
    <PackageVersion>10.0.12-ankus.5</PackageVersion>
    <Description>Patched .NET Native AOT compiler host for Ankus PostgreSQL extensions.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)../../PACKAGE.md" />
    <_AnkusCompilerPayload Include="$(AnkusCompilerToolsPath)*"
                           Exclude="$(AnkusCompilerToolsPath)*.dbg;$(AnkusCompilerToolsPath)*.dwarf;$(AnkusCompilerToolsPath)*.pdb"
                           Condition="'$(AnkusCompilerToolsPath)' != ''" />
    <None Include="@(_AnkusCompilerPayload)" Pack="true" PackagePath="tools/ilc/" />
    <None Include="build/Ankus.NativeAot.Compiler.$(AnkusCompilerRuntimeIdentifier).props"
          Pack="true" PackagePath="build/$(PackageId).props"
          Condition="'$(AnkusCompilerRuntimeIdentifier)' != ''" />
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Include="$(AnkusRuntimeSourcePath)/LICENSE.TXT;$(AnkusRuntimeSourcePath)/THIRD-PARTY-NOTICES.TXT"
          Pack="true" PackagePath="/" />
  </ItemGroup>

  <Target Name="_ValidateAnkusCompilerPackage" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_AnkusCompilerExecutable>$(AnkusCompilerToolsPath)ilc</_AnkusCompilerExecutable>
      <_AnkusCompilerExecutable Condition="'$(AnkusCompilerRuntimeIdentifier)' == 'win-x64'">$(AnkusCompilerToolsPath)ilc.exe</_AnkusCompilerExecutable>
    </PropertyGroup>
    <Error Condition="'$(AnkusCompilerRuntimeIdentifier)' == ''" Text="AnkusCompilerRuntimeIdentifier is required." />
    <Error Condition="!Exists('build/Ankus.NativeAot.Compiler.$(AnkusCompilerRuntimeIdentifier).props')"
           Text="AnkusCompilerRuntimeIdentifier must name a supported Ankus compiler host package." />
    <Error Condition="!Exists('$(_AnkusCompilerExecutable)')"
           Text="AnkusCompilerToolsPath must identify the complete built Native AOT compiler host." />
    <Error Condition="!Exists('$(AnkusRuntimeSourcePath)/LICENSE.TXT')"
           Text="AnkusRuntimeSourcePath must identify the matching runtime source checkout." />
  </Target>
</Project>
