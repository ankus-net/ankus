<Project>
  <PropertyGroup>
    <UsingAnkusSdk>true</UsingAnkusSdk>
    <!-- Editors list a design-time build's high-importance messages as problems, so the build tool's progress
         lines are quiet there and stay visible in command-line builds. -->
    <_AnkusToolOutputImportance Condition="'$(DesignTimeBuild)' == 'true'">Low</_AnkusToolOutputImportance>
    <_AnkusToolOutputImportance Condition="'$(_AnkusToolOutputImportance)' == ''">High</_AnkusToolOutputImportance>
    <_AnkusNativeEnvironment Condition="'$(ANKUS_HOME)' != ''">ANKUS_HOME=$([MSBuild]::Escape($([MSBuild]::NormalizePath('$(MSBuildStartupDirectory)', '$(ANKUS_HOME)'))))</_AnkusNativeEnvironment>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <NativeLib>Shared</NativeLib>
    <!-- SDK 11 publishes Native AOT without the full build, leaving the output directory empty, yet still copies the
         documentation file from it. Extensions publish through the full build, as every SDK 10 publish does. -->
    <UseOptimizedPublish Condition="'$(UseOptimizedPublish)' == ''">false</UseOptimizedPublish>
    <UseCurrentRuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(UseCurrentRuntimeIdentifier)' == ''">true</UseCurrentRuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <AnkusReuseSchema Condition="'$(AnkusReuseSchema)' == ''">false</AnkusReuseSchema>
    <AnkusVersionedLibrary Condition="'$(AnkusVersionedLibrary)' == ''">false</AnkusVersionedLibrary>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="MSBuildProjectDirectory" />
    <CompilerVisibleProperty Include="AnkusIncludeTests" />
    <CompilerVisibleProperty Include="AnkusIncludeBenchmarks" />
    <CompilerVisibleProperty Include="Version" />
    <AnkusUpgradeScript Include="sql/$(AnkusExtensionName)--*--*.sql"
                        Condition="'$(EnableDefaultAnkusUpgradeScripts)' != 'false' and '$(AnkusExtensionName)' != ''" />
    <AnkusUpgradeScript Include="sql/$(TargetName.ToLowerInvariant().Replace('.', '_'))--*--*.sql"
                        Condition="'$(EnableDefaultAnkusUpgradeScripts)' != 'false' and '$(AnkusExtensionName)' == ''" />
    <AnkusVersionControlFile Include="sql/$(AnkusExtensionName)--*.control"
                             Condition="'$(EnableDefaultAnkusVersionControlFiles)' != 'false' and '$(AnkusExtensionName)' != ''" />
    <AnkusVersionControlFile Include="sql/$(TargetName.ToLowerInvariant().Replace('.', '_'))--*.control"
                             Condition="'$(EnableDefaultAnkusVersionControlFiles)' != 'false' and '$(AnkusExtensionName)' == ''" />
  </ItemGroup>
</Project>
