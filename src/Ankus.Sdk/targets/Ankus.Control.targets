<Project>
  <PropertyGroup>
    <AnkusGenerateControlFileDependsOn>Build;SetupOSSpecificProps;_ResolveAnkusExtensionIdentity;_ResolveAnkusNativeLibrary;$(AnkusGenerateControlFileDependsOn)</AnkusGenerateControlFileDependsOn>
  </PropertyGroup>

  <Target Name="_ResolveAnkusExtensionIdentity">
    <PropertyGroup>
      <AnkusExtensionName Condition="'$(AnkusExtensionName)' == ''">$(TargetName.ToLowerInvariant().Replace('.', '_'))</AnkusExtensionName>
      <AnkusExtensionVersion Condition="'$(AnkusExtensionVersion)' == ''">$(Version)</AnkusExtensionVersion>
    </PropertyGroup>
  </Target>

  <Target Name="AnkusGenerateControlFile" DependsOnTargets="$(AnkusGenerateControlFileDependsOn)"
          Returns="@(_AnkusGeneratedControlFile)">
    <PropertyGroup>
      <AnkusControlOutput Condition="'$(AnkusControlOutput)' == ''">$(IntermediateOutputPath)ankus-control/$(AnkusExtensionName).control</AnkusControlOutput>
      <_AnkusControlCommand>dotnet &quot;$(_AnkusBuildTool)&quot; control-file &quot;$(TargetPath)&quot; &quot;$(AnkusControlOutput)&quot; $(AnkusPostgresMajor)</_AnkusControlCommand>
      <_AnkusControlCommand>$(_AnkusControlCommand) &quot;$(AnkusExtensionName)&quot; &quot;$(AnkusExtensionVersion)&quot; &quot;$(_AnkusNativeLibrary)&quot; &quot;$(AnkusExtensionControlFile)&quot;</_AnkusControlCommand>
      <_AnkusControlCommand>$(_AnkusControlCommand) &quot;$(_AnkusVersionedLibrary)&quot;</_AnkusControlCommand>
    </PropertyGroup>
    <Exec Command="$(_AnkusControlCommand)" StandardOutputImportance="$(_AnkusToolOutputImportance)" />
    <ItemGroup>
      <_AnkusGeneratedControlFile Include="$(AnkusControlOutput)" />
      <FileWrites Include="$(AnkusControlOutput)" />
    </ItemGroup>
  </Target>
</Project>
