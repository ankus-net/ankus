<Project>
  <!-- AnkusPostgresMajor and its explicit-selection marker are evaluated by Ankus.PostgresSelection.targets,
       after Directory.Build.targets. Consume them only inside targets. -->
  <PropertyGroup>
    <AnkusResolveBindingsDependsOn>_ResolveAnkusPostgresSelection;$(AnkusResolveBindingsDependsOn);ResolveReferences;_PrepareAnkusBindingToolchain</AnkusResolveBindingsDependsOn>
  </PropertyGroup>

  <!-- A pg_config path is authoritative when the project did not explicitly select a major.
       Resolve it before compiler constants, native suffixes and binding inputs consume the fallback. -->
  <Target Name="_ResolveAnkusPostgresSelection">
    <PropertyGroup>
      <_AnkusResolvedPgConfigPath>$(AnkusPgConfigPath)</_AnkusResolvedPgConfigPath>
      <_AnkusPgConfigDirectory>$([System.IO.Path]::GetDirectoryName('$(AnkusPgConfigPath)'))</_AnkusPgConfigDirectory>
      <_AnkusResolvedPgConfigPath Condition="'$(_AnkusPgConfigDirectory)' != ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(AnkusPgConfigPath)'))</_AnkusResolvedPgConfigPath>
    </PropertyGroup>
    <ItemGroup>
      <_AnkusPgConfigVersionOutput Remove="@(_AnkusPgConfigVersionOutput)" />
    </ItemGroup>
    <Exec Command="&quot;$(_AnkusResolvedPgConfigPath)&quot; --version"
          Condition="'$(_AnkusResolvedPgConfigPath)' != '' and '$(_AnkusPostgresMajorWasSpecified)' != 'true'"
          ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_AnkusPgConfigVersionOutput" />
    </Exec>
    <PropertyGroup Condition="'$(_AnkusResolvedPgConfigPath)' != '' and '$(_AnkusPostgresMajorWasSpecified)' != 'true'">
      <_AnkusPgConfigVersion>@(_AnkusPgConfigVersionOutput)</_AnkusPgConfigVersion>
      <_AnkusPgConfigMajor>$([System.Text.RegularExpressions.Regex]::Match('$(_AnkusPgConfigVersion)', '[0-9]+').Value)</_AnkusPgConfigMajor>
    </PropertyGroup>
    <Error Condition="'$(_AnkusResolvedPgConfigPath)' != '' and '$(_AnkusPostgresMajorWasSpecified)' != 'true' and ('$(_AnkusPgConfigMajor)' == '' or '$(_AnkusPgConfigMajor)' &lt; '13' or '$(_AnkusPgConfigMajor)' &gt; '19')"
           Text="AnkusPgConfigPath must identify a supported PostgreSQL 13–19 installation." />
    <PropertyGroup Condition="'$(_AnkusResolvedPgConfigPath)' != '' and '$(_AnkusPostgresMajorWasSpecified)' != 'true'">
      <AnkusPostgresMajor>$(_AnkusPgConfigMajor)</AnkusPostgresMajor>
    </PropertyGroup>

    <!-- Target information exported on another machine stands in for its pg_config: the manifest supplies that
         installation's build values, its headers and the bindings measured there. An archive is extracted once
         into a directory named by its hash, which `ankus` commands share. -->
    <Error Condition="'$(AnkusTargetInfo)' != '' and '$(AnkusPgConfigPath)' != ''"
           Text="Select either AnkusTargetInfo or AnkusPgConfigPath, not both." />
    <PropertyGroup Condition="'$(AnkusTargetInfo)' != ''">
      <_AnkusTargetInfoPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(AnkusTargetInfo)'))</_AnkusTargetInfoPath>
      <_AnkusTargetCacheDirectory Condition="'$(AnkusBindingCacheDirectory)' != ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(AnkusBindingCacheDirectory)', 'targets'))</_AnkusTargetCacheDirectory>
      <_AnkusTargetCacheDirectory Condition="'$(AnkusBindingCacheDirectory)' == ''">$([MSBuild]::NormalizeDirectory($([System.Environment]::GetFolderPath(SpecialFolder.LocalApplicationData)), 'Ankus', 'targets'))</_AnkusTargetCacheDirectory>
      <_AnkusTargetDirectory />
    </PropertyGroup>
    <Error Condition="'$(AnkusTargetInfo)' != '' and !Exists('$(_AnkusTargetInfoPath)')"
           Text="AnkusTargetInfo '$(AnkusTargetInfo)' does not exist." />
    <GetFileHash Condition="'$(AnkusTargetInfo)' != '' and $(_AnkusTargetInfoPath.ToLowerInvariant().EndsWith('.zip'))"
                 Files="$(_AnkusTargetInfoPath)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_AnkusTargetInfoHash" />
    </GetFileHash>
    <PropertyGroup Condition="'$(AnkusTargetInfo)' != ''">
      <_AnkusTargetDirectory Condition="'$(_AnkusTargetInfoHash)' != ''">$(_AnkusTargetCacheDirectory)$(_AnkusTargetInfoHash.ToLowerInvariant())</_AnkusTargetDirectory>
      <_AnkusTargetDirectory Condition="'$(_AnkusTargetDirectory)' == '' and Exists('$(_AnkusTargetInfoPath)/ankus-target.json')">$(_AnkusTargetInfoPath)</_AnkusTargetDirectory>
      <_AnkusTargetDirectory Condition="'$(_AnkusTargetDirectory)' == '' and $([System.IO.Path]::GetFileName('$(_AnkusTargetInfoPath)')) == 'ankus-target.json'">$([System.IO.Path]::GetDirectoryName('$(_AnkusTargetInfoPath)'))</_AnkusTargetDirectory>
    </PropertyGroup>
    <Unzip Condition="'$(_AnkusTargetInfoHash)' != '' and !Exists('$(_AnkusTargetDirectory)/ankus-target.json')"
           SourceFiles="$(_AnkusTargetInfoPath)" DestinationFolder="$(_AnkusTargetDirectory)" SkipUnchangedFiles="true" />
    <Error Condition="'$(AnkusTargetInfo)' != '' and !Exists('$(_AnkusTargetDirectory)/ankus-target.json')"
           Text="AnkusTargetInfo must name an archive from 'ankus target export', its extracted directory or its ankus-target.json." />
    <PropertyGroup Condition="'$(AnkusTargetInfo)' != ''">
      <_AnkusResolvedPgConfigPath>$([MSBuild]::NormalizePath('$(_AnkusTargetDirectory)', 'ankus-target.json'))</_AnkusResolvedPgConfigPath>
      <_AnkusTargetMajor>$([System.IO.File]::ReadAllText('$(_AnkusTargetDirectory)/postgres-major').Trim())</_AnkusTargetMajor>
      <_AnkusTargetRuntimeIdentifier>$([System.IO.File]::ReadAllText('$(_AnkusTargetDirectory)/runtime-identifier').Trim())</_AnkusTargetRuntimeIdentifier>
    </PropertyGroup>
    <Error Condition="'$(AnkusTargetInfo)' != '' and '$(RuntimeIdentifier)' != '$(_AnkusTargetRuntimeIdentifier)'"
           Text="AnkusTargetInfo describes $(_AnkusTargetRuntimeIdentifier). Build with RuntimeIdentifier=$(_AnkusTargetRuntimeIdentifier)." />
    <Error Condition="'$(AnkusTargetInfo)' != '' and '$(_AnkusPostgresMajorWasSpecified)' == 'true' and '$(AnkusPostgresMajor)' != '$(_AnkusTargetMajor)'"
           Text="AnkusTargetInfo describes PostgreSQL $(_AnkusTargetMajor), but AnkusPostgresMajor is $(AnkusPostgresMajor)." />
    <PropertyGroup Condition="'$(AnkusTargetInfo)' != ''">
      <AnkusPostgresMajor>$(_AnkusTargetMajor)</AnkusPostgresMajor>
    </PropertyGroup>
  </Target>

  <!-- Measures the selected installation's bindings on this machine and archives them with its headers, so other
       machines can build for this runtime (`ankus target export`). -->
  <Target Name="AnkusExportTargetInfo" DependsOnTargets="_ResolveAnkusPostgresSelection;ResolveReferences;_PrepareAnkusBindingToolchain">
    <Error Condition="'$(AnkusTargetInfo)' != ''"
           Text="Export target information from the target machine's own pg_config, not from AnkusTargetInfo." />
    <Error Condition="'$(PublishAot)' != 'true' or '$(RuntimeIdentifier)' == ''"
           Text="Exporting target information requires PublishAot and a RuntimeIdentifier." />
    <PropertyGroup>
      <_AnkusBuildTool Condition="'@(_AnkusBuildToolAssembly)' != ''">@(_AnkusBuildToolAssembly->'%(FullPath)')</_AnkusBuildTool>
      <_AnkusTargetInfoOutput>$(AnkusTargetInfoOutput)</_AnkusTargetInfoOutput>
      <_AnkusTargetInfoOutput Condition="'$(_AnkusTargetInfoOutput)' == ''">ankus-target.pg$(AnkusPostgresMajor).$(RuntimeIdentifier).zip</_AnkusTargetInfoOutput>
      <_AnkusTargetInfoOutput>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_AnkusTargetInfoOutput)'))</_AnkusTargetInfoOutput>
      <_AnkusBindingCacheDirectory Condition="'$(AnkusBindingCacheDirectory)' != ''">$([MSBuild]::EnsureTrailingSlash('$(AnkusBindingCacheDirectory)')).</_AnkusBindingCacheDirectory>
      <_AnkusTargetExportCommand>dotnet &quot;$(_AnkusBuildTool)&quot; target-export &quot;$(AnkusPostgresMajor)&quot; &quot;$(_AnkusResolvedPgConfigPath)&quot; &quot;$(_AnkusTargetInfoOutput)&quot;</_AnkusTargetExportCommand>
      <_AnkusTargetExportCommand>$(_AnkusTargetExportCommand) &quot;@(_AnkusBindingToolchain->'%(Compiler)')&quot; &quot;@(_AnkusBindingToolchain->'%(LibraryDirectories)')&quot;</_AnkusTargetExportCommand>
      <_AnkusTargetExportCommand>$(_AnkusTargetExportCommand) &quot;$(RuntimeIdentifier)&quot; &quot;@(_AnkusBindingToolchain->'%(TargetTriple)')&quot;</_AnkusTargetExportCommand>
      <_AnkusTargetExportCommand>$(_AnkusTargetExportCommand) &quot;$(AnkusClangPath)&quot; &quot;$(AnkusLibClangPath)&quot; &quot;$(_AnkusBindingCacheDirectory)&quot;</_AnkusTargetExportCommand>
    </PropertyGroup>
    <Exec Command="$(_AnkusTargetExportCommand)" EnvironmentVariables="$(_AnkusNativeEnvironment)" StandardOutputImportance="$(_AnkusToolOutputImportance)" />
  </Target>

  <!-- Resolve after project evaluation so consumer and Directory.Build.targets overrides apply.
       Direct compiler entry points also need the selected-header symbol. -->
  <Target Name="_AddAnkusPostgresDefineConstants" AfterTargets="PrepareForBuild"
          BeforeTargets="BeforeCompile;CoreCompile" DependsOnTargets="_ResolveAnkusPostgresSelection">
    <PropertyGroup>
      <DefineConstants>$(DefineConstants);ANKUS_PG$(AnkusPostgresMajor)</DefineConstants>
      <!-- Like pgrx's pg_test feature, these let code exist only in test or benchmark publications. -->
      <DefineConstants Condition="'$(AnkusIncludeTests)' == 'true'">$(DefineConstants);ANKUS_TESTS</DefineConstants>
      <DefineConstants Condition="'$(AnkusIncludeBenchmarks)' == 'true'">$(DefineConstants);ANKUS_BENCHMARKS</DefineConstants>
    </PropertyGroup>
  </Target>

  <Target Name="_PrepareAnkusBindingToolchain" Condition="'$(PublishAot)' == 'true'">
    <!-- Native AOT setup also captures linker inputs that do not exist before compilation.
         Discover its compiler in a separate project instance and return only the toolchain. -->
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_GetAnkusBindingToolchain"
             Properties="_AnkusBindingToolchainEvaluation=true">
      <Output TaskParameter="TargetOutputs" ItemName="_AnkusBindingToolchain" />
    </MSBuild>
  </Target>

  <Target Name="_GetAnkusBindingToolchain" DependsOnTargets="ResolveFrameworkReferences;SetupOSSpecificProps"
          Returns="@(_AnkusDiscoveredBindingToolchain)">
    <PropertyGroup>
      <_AnkusDiscoveredCompiler>$(CppLinker)</_AnkusDiscoveredCompiler>
      <_AnkusDiscoveredCompiler Condition="'$(_targetOS)' == 'win'">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName('$(CppLinker)')), 'cl.exe'))</_AnkusDiscoveredCompiler>
    </PropertyGroup>
    <ItemGroup>
      <_AnkusDiscoveredBindingToolchain Include="NativeCompiler">
        <Compiler>$(_AnkusDiscoveredCompiler)</Compiler>
        <LibraryDirectories>@(AdditionalNativeLibraryDirectories, ';')</LibraryDirectories>
        <TargetTriple>$(TargetTriple)</TargetTriple>
      </_AnkusDiscoveredBindingToolchain>
    </ItemGroup>
  </Target>

  <Target Name="_ResolveAnkusBindings" BeforeTargets="FindReferenceAssembliesForReferences"
          DependsOnTargets="$(AnkusResolveBindingsDependsOn)">
    <PropertyGroup>
      <_AnkusBuildTool Condition="'@(_AnkusBuildToolAssembly)' != ''">@(_AnkusBuildToolAssembly->'%(FullPath)')</_AnkusBuildTool>
      <_AnkusBindingsOutput>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'ankus-bindings'))</_AnkusBindingsOutput>
      <_AnkusBindingsDirectory>$(_AnkusBindingsOutput)/</_AnkusBindingsDirectory>
      <_AnkusBindingsCompiler>@(_AnkusBindingToolchain->'%(Compiler)')</_AnkusBindingsCompiler>
      <_AnkusBindingsLibraries>@(_AnkusBindingToolchain->'%(LibraryDirectories)')</_AnkusBindingsLibraries>
      <_AnkusBindingsTargetTriple>@(_AnkusBindingToolchain->'%(TargetTriple)')</_AnkusBindingsTargetTriple>
      <!-- A final dot preserves quoted Windows directory arguments with a trailing backslash. -->
      <_AnkusBindingCacheDirectory Condition="'$(AnkusBindingCacheDirectory)' != ''">$([MSBuild]::EnsureTrailingSlash('$(AnkusBindingCacheDirectory)')).</_AnkusBindingCacheDirectory>
      <_AnkusBindingsCommand>dotnet &quot;$(_AnkusBuildTool)&quot; binding-sources &quot;$(AnkusPostgresMajor)&quot; &quot;$(_AnkusResolvedPgConfigPath)&quot; &quot;$(_AnkusBindingsOutput)&quot;</_AnkusBindingsCommand>
      <_AnkusBindingsCommand>$(_AnkusBindingsCommand) &quot;$(_AnkusBindingsCompiler)&quot; &quot;$(_AnkusBindingsLibraries)&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(_AnkusBindingsTargetTriple)&quot;</_AnkusBindingsCommand>
      <_AnkusBindingsCommand>$(_AnkusBindingsCommand) &quot;$(AnkusClangPath)&quot; &quot;$(AnkusLibClangPath)&quot;</_AnkusBindingsCommand>
      <_AnkusBindingsCommand>$(_AnkusBindingsCommand) &quot;$(_AnkusBindingCacheDirectory)&quot;</_AnkusBindingsCommand>
    </PropertyGroup>
    <ItemGroup>
      <_AnkusBindingRuntime Include="@(ReferencePath)" Condition="'%(Filename)' == 'Ankus.Runtime'" />
    </ItemGroup>
    <Error Condition="'@(_AnkusBindingRuntime)' == ''" Text="Native bindings require the resolved Ankus.Runtime assembly." />
    <Exec Command="$(_AnkusBindingsCommand)" EnvironmentVariables="$(_AnkusNativeEnvironment)" StandardOutputImportance="$(_AnkusToolOutputImportance)" />
    <ReadLinesFromFile File="$(_AnkusBindingsDirectory)native-binding.assembly-name">
      <Output TaskParameter="Lines" PropertyName="_AnkusBindingAssemblyName" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <!-- A final dot keeps directory arguments literal when Windows parses a closing quote after a backslash. -->
      <_AnkusBindingSdkDirectory>$([MSBuild]::EnsureTrailingSlash('$(MSBuildToolsPath)')).</_AnkusBindingSdkDirectory>
      <_AnkusBindingCompileCommand>dotnet &quot;$(_AnkusBuildTool)&quot; binding-compile &quot;$(_AnkusBindingsOutput)&quot; &quot;@(_AnkusBindingRuntime)&quot; &quot;$(TargetFramework)&quot; &quot;$(Configuration)&quot;</_AnkusBindingCompileCommand>
      <_AnkusBindingCompileCommand>$(_AnkusBindingCompileCommand) &quot;$(NETCoreSdkVersion)&quot; &quot;$(_AnkusBindingSdkDirectory)&quot; &quot;$(ProjectAssetsFile)&quot; &quot;$(_AnkusBindingCacheDirectory)&quot;</_AnkusBindingCompileCommand>
    </PropertyGroup>
    <Exec Command="$(_AnkusBindingCompileCommand)" EnvironmentVariables="$(_AnkusNativeEnvironment)" StandardOutputImportance="$(_AnkusToolOutputImportance)" />
    <ReadLinesFromFile File="$(_AnkusBindingsDirectory)native-binding.assembly-path">
      <Output TaskParameter="Lines" ItemName="_AnkusBindingAssembly" />
    </ReadLinesFromFile>
    <ItemGroup>
      <!-- A referenced extension can already supply this exact companion contract. -->
      <ReferencePath Remove="@(ReferencePath)" Condition="'%(Filename)' == '$(_AnkusBindingAssemblyName)'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == '$(_AnkusBindingAssemblyName)'" />
      <ReferencePath Include="@(_AnkusBindingAssembly)">
        <ReferenceSourceTarget>ResolveAssemblyReference</ReferenceSourceTarget>
        <CopyLocal>true</CopyLocal>
        <Private>true</Private>
      </ReferencePath>
      <ReferenceCopyLocalPaths Include="@(_AnkusBindingAssembly)">
        <ReferenceSourceTarget>ResolveAssemblyReference</ReferenceSourceTarget>
        <CopyLocal>true</CopyLocal>
        <Private>true</Private>
      </ReferenceCopyLocalPaths>
      <TargetPathWithTargetPlatformMoniker Remove="@(TargetPathWithTargetPlatformMoniker)"
                                           Condition="'%(TargetPathWithTargetPlatformMoniker.AnkusBindingReference)' == 'true'" />
      <TargetPathWithTargetPlatformMoniker Include="@(_AnkusBindingAssembly)">
        <ReferenceSourceTarget>ResolveAssemblyReference</ReferenceSourceTarget>
        <AnkusBindingReference>true</AnkusBindingReference>
      </TargetPathWithTargetPlatformMoniker>
      <FileWrites Include="$(_AnkusBindingsDirectory)**/*" />
    </ItemGroup>
    <OnError ExecuteTargets="_RecordAnkusBindingFiles" />
  </Target>

  <!-- ProjectReference consumers also need the companion when requesting existing outputs. -->
  <Target Name="_ReadAnkusBindingReference" AfterTargets="GetTargetPathWithTargetPlatformMoniker">
    <PropertyGroup>
      <_AnkusBindingReferenceFile>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'ankus-bindings', 'native-binding.assembly-path'))</_AnkusBindingReferenceFile>
    </PropertyGroup>
    <ReadLinesFromFile File="$(_AnkusBindingReferenceFile)" Condition="Exists('$(_AnkusBindingReferenceFile)')">
      <Output TaskParameter="Lines" ItemName="_AnkusExistingBindingReference" />
    </ReadLinesFromFile>
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="@(_AnkusExistingBindingReference)">
        <ReferenceSourceTarget>ResolveAssemblyReference</ReferenceSourceTarget>
        <AnkusBindingReference>true</AnkusBindingReference>
        <TargetFrameworkIdentifier>$(TargetFrameworkIdentifier)</TargetFrameworkIdentifier>
        <TargetFrameworkVersion>$(TargetFrameworkVersion.TrimStart('vV'))</TargetFrameworkVersion>
      </TargetPathWithTargetPlatformMoniker>
    </ItemGroup>
  </Target>

  <Target Name="_RecordAnkusBindingFiles">
    <ItemGroup>
      <FileWrites Include="$(_AnkusBindingsDirectory)**/*" />
    </ItemGroup>
  </Target>
</Project>
