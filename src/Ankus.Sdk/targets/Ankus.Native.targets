<Project>
  <Target Name="_SelectAnkusWindowsEnvironment" AfterTargets="SetupOSSpecificProps"
          Condition="'$(_targetOS)' == 'win' and '$(IlcUseEnvironmentalTools)' == 'true'">
    <!-- Native AOT uses PATH and LIB from the configured developer environment.
         Carry those same library roots into Ankus's header and ABI checks. -->
    <ItemGroup>
      <AdditionalNativeLibraryDirectories Include="$(LIB)" />
    </ItemGroup>
  </Target>

  <Target Name="_SelectAnkusNativeLibrarySuffix" BeforeTargets="SetupOSSpecificProps"
          DependsOnTargets="ImportRuntimeIlcPackageTarget;_ResolveAnkusPostgresSelection" Condition="'$(PublishAot)' == 'true'">
    <!-- PostgreSQL on macOS used .so before PostgreSQL 16. Select the backend's
         name before linker, control-file and publication paths are constructed. -->
    <PropertyGroup Condition="'$(_targetOS)' == 'osx' and '$(AnkusPostgresMajor)' &lt; '16'">
      <NativeBinaryExt>.so</NativeBinaryExt>
      <NativeBinary>$(NativeOutputPath)$(NativeBinaryPrefix)$(TargetName)$(NativeBinaryExt)</NativeBinary>
    </PropertyGroup>
  </Target>

  <Target Name="_ResolveAnkusNativeLibrary" BeforeTargets="SetupOSSpecificProps"
          DependsOnTargets="_SelectAnkusNativeLibrarySuffix">
    <!-- AnkusLibraryName names the native library without changing the assembly, like Cargo's [lib] name.
         AnkusVersionedLibrary follows cargo-pgrx's versioned shared-object mode: append the extension version so
         each version's library can be installed beside the others. Installation SQL then names that library. -->
    <PropertyGroup>
      <!-- MSBuild conditions also accept on and yes as true; pass the build tool one canonical value. -->
      <_AnkusVersionedLibrary>false</_AnkusVersionedLibrary>
      <_AnkusVersionedLibrary Condition="'$(AnkusVersionedLibrary)' == 'true'">true</_AnkusVersionedLibrary>
      <!-- The same default as _ResolveAnkusExtensionIdentity, which these native targets do not require. -->
      <_AnkusLibraryVersion>$(AnkusExtensionVersion)</_AnkusLibraryVersion>
      <_AnkusLibraryVersion Condition="'$(_AnkusLibraryVersion)' == ''">$(Version)</_AnkusLibraryVersion>
      <_AnkusNativeLibraryStem>$(NativeBinaryPrefix)$(TargetName)</_AnkusNativeLibraryStem>
      <_AnkusNativeLibraryStem Condition="'$(AnkusLibraryName)' != ''">$(NativeBinaryPrefix)$(AnkusLibraryName)</_AnkusNativeLibraryStem>
      <_AnkusNativeLibraryStem Condition="'$(_AnkusVersionedLibrary)' == 'true'">$(_AnkusNativeLibraryStem)-$(_AnkusLibraryVersion)</_AnkusNativeLibraryStem>
      <_AnkusNativeLibrary>$(_AnkusNativeLibraryStem)$(NativeBinaryExt)</_AnkusNativeLibrary>
      <_AnkusNativeLibraryRenamed>false</_AnkusNativeLibraryRenamed>
      <_AnkusNativeLibraryRenamed Condition="'$(AnkusLibraryName)' != '' or '$(_AnkusVersionedLibrary)' == 'true'">true</_AnkusNativeLibraryRenamed>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_AnkusNativeLibraryRenamed)' == 'true'">
      <NativeBinary>$(NativeOutputPath)$(_AnkusNativeLibrary)</NativeBinary>
      <!-- Give each library, including each version, a macOS install name matching its filename. -->
      <SharedLibraryInstallName Condition="'$(_targetOS)' == 'osx' and '$(SharedLibraryInstallName)' == ''">@rpath/$(_AnkusNativeLibrary)</SharedLibraryInstallName>
    </PropertyGroup>
  </Target>

  <Target Name="_CopyAnkusNativeLibrarySymbols" AfterTargets="_CopyAotSymbols" DependsOnTargets="_ResolveAnkusNativeLibrary"
          Condition="'$(PublishAot)' == 'true' and '$(CopyOutputSymbolsToPublishDirectory)' == 'true'">
    <!-- Native AOT copies symbols named after TargetName. A renamed library's symbols, and its debug link,
         use the library's filename instead. -->
    <PropertyGroup Condition="'$(_AnkusNativeLibraryRenamed)' == 'true'">
      <_AnkusLibrarySymbols Condition="'$(OS)' == 'Windows_NT'">$(NativeOutputPath)$(_AnkusNativeLibraryStem)$(NativeSymbolExt)</_AnkusLibrarySymbols>
      <_AnkusLibrarySymbols Condition="'$(OS)' != 'Windows_NT'">$(NativeBinary)$(NativeSymbolExt)</_AnkusLibrarySymbols>
    </PropertyGroup>
    <ItemGroup Condition="'$(_AnkusNativeLibraryRenamed)' == 'true'">
      <_AnkusLibrarySymbolFile Include="$(_AnkusLibrarySymbols)" Condition="'$(NativeSymbolExt)' != '.dSYM' and Exists('$(_AnkusLibrarySymbols)')" />
      <!-- macOS symbols are a dSYM bundle directory. -->
      <_AnkusLibrarySymbolBundleFile Include="$(_AnkusLibrarySymbols)/**/*" Condition="'$(NativeSymbolExt)' == '.dSYM'" />
    </ItemGroup>
    <Copy SourceFiles="@(_AnkusLibrarySymbolFile)" DestinationFolder="$(PublishDir)" />
    <Copy SourceFiles="@(_AnkusLibrarySymbolBundleFile)"
          DestinationFolder="$(PublishDir)$([System.IO.Path]::GetFileName('$(_AnkusLibrarySymbols)'))/%(_AnkusLibrarySymbolBundleFile.RecursiveDir)" />
  </Target>

  <Target Name="_CleanAnkusSchemaSnapshots" BeforeTargets="CoreClean" Condition="'$(NativeIntermediateOutputPath)' != ''">
    <ItemGroup>
      <Clean Include="$(NativeIntermediateOutputPath)ankus/schema-pg*-*.json" />
    </ItemGroup>
  </Target>

  <Target Name="_ValidateAnkusSchemaOptions" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(AnkusReuseSchema)' != 'true' and '$(AnkusReuseSchema)' != 'false'"
           Text="AnkusReuseSchema must be true or false." />
    <Error Condition="'$(AnkusVersionedLibrary)' != '' and '$(AnkusVersionedLibrary)' != 'true' and '$(AnkusVersionedLibrary)' != 'false'"
           Text="AnkusVersionedLibrary must be true or false." />
    <Error Condition="'$(AnkusLibraryName)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(AnkusLibraryName)', '^[A-Za-z0-9_+-][A-Za-z0-9._+-]*$'))"
           Text="AnkusLibraryName must be a filename without a suffix or directory, using ASCII letters, digits, '.', '_', '+' or '-'." />
    <Error Condition="'$(AnkusIncludeBenchmarks)' != '' and '$(AnkusIncludeBenchmarks)' != 'true' and '$(AnkusIncludeBenchmarks)' != 'false'"
           Text="AnkusIncludeBenchmarks must be true or false." />
    <Error Condition="'$(AnkusIncludeTests)' == 'true' and '$(AnkusIncludeBenchmarks)' == 'true'"
           Text="AnkusIncludeTests and AnkusIncludeBenchmarks cannot both be true." />
  </Target>

  <Target Name="_InvalidateAnkusPublication" BeforeTargets="PrepareForBuild" Condition="'$(_IsPublishing)' == 'true'"
          DependsOnTargets="_InvalidateAnkusPublishManifest" />

  <Target Name="_InvalidateAnkusPublishManifest">
    <PropertyGroup>
      <_AnkusPublishedManifest>$(PublishDir.TrimEnd('/').TrimEnd('\'))/ankus.extension.json</_AnkusPublishedManifest>
      <_AnkusPreviousManifest>$(PublishDir.TrimEnd('/').TrimEnd('\'))/ankus.extension.previous.json</_AnkusPreviousManifest>
    </PropertyGroup>
    <Move SourceFiles="$(_AnkusPublishedManifest)" DestinationFiles="$(_AnkusPreviousManifest)"
          Condition="Exists('$(_AnkusPublishedManifest)')" />
  </Target>

  <Target Name="_ValidateAnkusPublish" BeforeTargets="PrepareForPublish" DependsOnTargets="_InvalidateAnkusPublishManifest">
    <Error Condition="'$(PublishAot)' != 'true'" Text="Ankus extensions require PublishAot=true." />
    <Error Condition="'$(OutputType)' != 'Library' or '$(NativeLib)' != 'Shared'"
           Text="Ankus extensions require OutputType=Library and NativeLib=Shared." />
  </Target>

  <Target Name="_PrepareAnkusNativeArtifacts" BeforeTargets="WriteIlcRspFileForCompilation"
          DependsOnTargets="Compile;SetupOSSpecificProps;_ResolveAnkusExtensionIdentity;_ResolveAnkusNativeLibrary">
    <PropertyGroup>
      <_AnkusArtifacts>$(NativeIntermediateOutputPath)ankus/</_AnkusArtifacts>
      <_AnkusSchemaMode>normal</_AnkusSchemaMode>
      <_AnkusSchemaMode Condition="'$(AnkusIncludeTests)' == 'true'">tests</_AnkusSchemaMode>
      <_AnkusSchemaMode Condition="'$(AnkusIncludeBenchmarks)' == 'true'">benchmarks</_AnkusSchemaMode>
      <_AnkusSchemaSnapshot>$(_AnkusArtifacts)schema-pg$(AnkusPostgresMajor)-$(_AnkusSchemaMode).json</_AnkusSchemaSnapshot>
      <_AnkusSchemaInput Condition="'$(AnkusReuseSchema)' == 'true'">$(_AnkusSchemaSnapshot)</_AnkusSchemaInput>
      <_AnkusSchemaInput Condition="'$(AnkusReuseSchema)' != 'true'"></_AnkusSchemaInput>
      <_AnkusSchemaOutput Condition="'$(AnkusReuseSchema)' != 'true'">$(_AnkusSchemaSnapshot)</_AnkusSchemaOutput>
      <_AnkusSchemaOutput Condition="'$(AnkusReuseSchema)' == 'true'"></_AnkusSchemaOutput>
      <_AnkusCommand>dotnet &quot;$(_AnkusBuildTool)&quot; &quot;@(IntermediateAssembly)&quot;</_AnkusCommand>
      <_AnkusCommand>$(_AnkusCommand) &quot;$(_AnkusArtifacts)&quot; $(AnkusPostgresMajor)</_AnkusCommand>
      <_AnkusLibraries>@(AdditionalNativeLibraryDirectories, ';')</_AnkusLibraries>
      <_AnkusCommand>$(_AnkusCommand) &quot;$(CppLinker)&quot; &quot;$(_AnkusLibraries)&quot;</_AnkusCommand>
      <_AnkusCommand>$(_AnkusCommand) &quot;$(AnkusExtensionName)&quot; &quot;$(AnkusExtensionVersion)&quot;</_AnkusCommand>
      <_AnkusCommand>$(_AnkusCommand) &quot;$(_AnkusNativeLibrary)&quot;</_AnkusCommand>
      <_AnkusCommand>$(_AnkusCommand) &quot;$(RuntimeIdentifier)&quot; &quot;$(_AnkusResolvedPgConfigPath)&quot;</_AnkusCommand>
      <_AnkusCommand>$(_AnkusCommand) &quot;$(TargetTriple)&quot;</_AnkusCommand>
      <_AnkusCommand>$(_AnkusCommand) &quot;$(AnkusExtensionControlFile)&quot;</_AnkusCommand>
      <_AnkusCommand>$(_AnkusCommand) &quot;$(_AnkusArtifacts)version-controls.txt&quot;</_AnkusCommand>
      <_AnkusCommand>$(_AnkusCommand) &quot;$(_AnkusSchemaInput)&quot; &quot;$(_AnkusVersionedLibrary)&quot;</_AnkusCommand>
    </PropertyGroup>
    <MakeDir Directories="$(_AnkusArtifacts)" />
    <WriteLinesToFile File="$(_AnkusArtifacts)version-controls.txt" Lines="@(AnkusVersionControlFile->'%(FullPath)')"
                      Overwrite="true" Encoding="UTF-8" />
    <Exec Command="$(_AnkusCommand)" EnvironmentVariables="$(_AnkusNativeEnvironment)" />
    <ReadLinesFromFile File="$(_AnkusArtifacts)exports.txt">
      <Output TaskParameter="Lines" ItemName="_AnkusExport" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(_AnkusArtifacts)libraries.txt">
      <Output TaskParameter="Lines" ItemName="_AnkusNativeLibrary" />
    </ReadLinesFromFile>
    <ItemGroup>
      <DirectPInvoke Include="Ankus.NativeBodies" />
      <IlcArg Include="@(_AnkusExport->'--export-dynamic-symbol:%(Identity)')" />
      <NativeLibrary Include="@(_AnkusNativeLibrary)" />
      <LinkerArg Include="@(_AnkusNativeLibrary->'&quot;%(Identity)&quot;')" />
      <LinkerArg Include="-Wl,-undefined,dynamic_lookup" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
      <!-- PostgreSQL loads libraries RTLD_GLOBAL. Bind each library's calls to its own exported managed entries, as
           macOS and Windows already do, so two versioned libraries of one extension in a backend never call each other. -->
      <LinkerArg Include="-Wl,-Bsymbolic" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
      <FileWrites Include="$(_AnkusArtifacts)**/*" />
    </ItemGroup>
  </Target>

  <Target Name="_PrepareAnkusNativeCalls" BeforeTargets="LinkNative" DependsOnTargets="IlcCompile">
    <PropertyGroup>
      <_AnkusNativeCallsCommand>dotnet &quot;$(_AnkusBuildTool)&quot; binding-link &quot;$(_AnkusBindingsDirectory)native-records.json&quot; &quot;$(_AnkusResolvedPgConfigPath)&quot; &quot;$(_AnkusArtifacts)&quot;</_AnkusNativeCallsCommand>
      <_AnkusNativeCallsCommand>$(_AnkusNativeCallsCommand) &quot;$(NativeObject)&quot; &quot;$(CppLinker)&quot; &quot;$(_AnkusLibraries)&quot; &quot;$(TargetTriple)&quot;</_AnkusNativeCallsCommand>
      <_AnkusNativeCallsCommand>$(_AnkusNativeCallsCommand) &quot;$(_AnkusBindingCacheDirectory)&quot;</_AnkusNativeCallsCommand>
    </PropertyGroup>
    <Exec Command="$(_AnkusNativeCallsCommand)" EnvironmentVariables="$(_AnkusNativeEnvironment)" />
    <ReadLinesFromFile File="$(_AnkusArtifacts)native-call-libraries.txt">
      <Output TaskParameter="Lines" ItemName="_AnkusNativeCallLibrary" />
    </ReadLinesFromFile>
    <ItemGroup>
      <NativeLibrary Include="@(_AnkusNativeCallLibrary)" />
      <!-- Generated calls must precede the archives that supply their native symbols. -->
      <_AnkusLinkerArgumentsAfterCalls Include="@(LinkerArg)" />
      <LinkerArg Remove="@(LinkerArg)" />
      <LinkerArg Include="@(_AnkusNativeCallLibrary->'&quot;%(Identity)&quot;')" />
      <LinkerArg Include="@(_AnkusLinkerArgumentsAfterCalls)" />
      <FileWrites Include="$(_AnkusArtifacts)**/*" />
    </ItemGroup>
  </Target>

  <Target Name="_QuoteAnkusNativeLibraries" BeforeTargets="LinkNative" DependsOnTargets="_PrepareAnkusNativeCalls" Condition="'$(_targetOS)' != 'win'">
    <!-- .NET 10's Unix targets append NativeLibrary paths to LinkerArg without quoting.
         Quote existing file arguments in place, preserving static-library ordering. -->
    <ItemGroup>
      <_AnkusLinkerArgument Include="@(LinkerArg)">
        <Argument>%(Identity)</Argument>
        <Argument Condition="Exists('%(Identity)')">&quot;%(Identity)&quot;</Argument>
      </_AnkusLinkerArgument>
      <LinkerArg Remove="@(LinkerArg)" />
      <LinkerArg Include="@(_AnkusLinkerArgument->'%(Argument)')" />
    </ItemGroup>
  </Target>

  <Target Name="_PublishAnkusSchema" AfterTargets="Publish" DependsOnTargets="_ResolveAnkusNativeLibrary"
          Condition="'$(PublishAot)' == 'true'">
    <Copy SourceFiles="$(_AnkusArtifacts)schema.sql" DestinationFiles="$(PublishDir)$(TargetName).sql" />
    <WriteLinesToFile File="$(_AnkusArtifacts)upgrade-scripts.txt" Lines="@(AnkusUpgradeScript->'%(FullPath)')"
                      Overwrite="true" Encoding="UTF-8" />
    <Exec Command="dotnet &quot;$(_AnkusBuildTool)&quot; publish-sql &quot;$(_AnkusArtifacts.TrimEnd('/').TrimEnd('\'))&quot; &quot;$(PublishDir.TrimEnd('/').TrimEnd('\'))&quot; &quot;$(_AnkusArtifacts)upgrade-scripts.txt&quot; &quot;$(MSBuildProjectDirectory)&quot; &quot;$(AnkusExtensionVersion)&quot; &quot;$(_AnkusSchemaOutput)&quot; &quot;$(_AnkusVersionedLibrary)&quot;" />
    <ItemGroup>
      <_AnkusPackageFile Include="$(_AnkusArtifacts)extension/$(AnkusExtensionName).control" />
      <_AnkusPackageFile Include="$(_AnkusArtifacts)extension/$(AnkusExtensionName)--$(AnkusExtensionVersion).sql" />
      <_AnkusPackageFile Include="@(AnkusUpgradeScript)" />
      <_AnkusPackageFile Include="@(AnkusVersionControlFile)" />
    </ItemGroup>
    <ItemGroup>
      <FileWrites Include="$(PublishDir)$(TargetName).sql" />
      <FileWrites Include="$(_AnkusArtifacts)upgrade-scripts.txt" />
      <FileWrites Include="$(_AnkusSchemaSnapshot)" />
      <FileWrites Include="$(PublishDir.TrimEnd('/').TrimEnd('\'))/ankus.extension.json" />
      <FileWrites Include="@(_AnkusPackageFile->'$(PublishDir)extension/%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>
</Project>
