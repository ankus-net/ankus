{
  "$schema": "http://json.schemastore.org/template",
  "author": "Brandon Williams",
  "classifications": ["Database", "PostgreSQL", "Native AOT"],
  "identity": "Ankus.__IDENTITY__.CSharp",
  "name": "__DISPLAY_NAME__",
  "shortName": "__SHORT_NAME__",
  "tags": { "language": "C#", "type": "project" },
  "preferNameDirectory": true,
  "sources": [
    {
      "modifiers": [
        { "exclude": ["**/pg_regress/expected/**", "Frameworks/**"] },
        {
          "condition": "(testFramework != \"mstest\")",
          "exclude": ["global.json", "Directory.Packages.props", "tests/**/BackendTests.cs", "tests/**/ManagedTests.cs", "tests/**/*.csproj", "tests/**/WorkerBackendTests.cs"]
        }
      ]
    },
    { "include": ["**/pg_regress/expected/**"] },
    { "source": "Frameworks/Xunit/", "target": "./", "condition": "(testFramework == \"xunit\")" },
    { "source": "Frameworks/Nunit/", "target": "./", "condition": "(testFramework == \"nunit\")" },
    { "source": "Frameworks/XunitWorker/", "target": "./", "condition": "(testFramework == \"xunit\" && __WORKER__)" },
    { "source": "Frameworks/NunitWorker/", "target": "./", "condition": "(testFramework == \"nunit\" && __WORKER__)" }
  ],
  "symbols": {
    "Framework": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "net10.0",
      "description": "Target framework for the extension and its tests",
      "choices": [
        { "choice": "net10.0", "description": ".NET 10" },
        { "choice": "net11.0", "description": ".NET 11 (release candidate)" }
      ],
      "replaces": "__TARGET_FRAMEWORK__"
    },
    "sdkVersion": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "Framework",
        "steps": [
          { "regex": "^net10\\.0$", "replacement": "10.0.400" },
          { "regex": "^net11\\.0$", "replacement": "11.0.100-rc.2.26504.105" }
        ]
      },
      "replaces": "__SDK_VERSION__"
    },
    "sdkAllowPrerelease": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "Framework",
        "steps": [
          { "regex": "^net10\\.0$", "replacement": "false" },
          { "regex": "^net11\\.0$", "replacement": "true" }
        ]
      },
      "replaces": "__SDK_ALLOW_PRERELEASE__"
    },
    "testFramework": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "mstest",
      "description": "Consumer test framework",
      "choices": [
        { "choice": "mstest", "description": "MSTest" },
        { "choice": "xunit", "description": "xUnit.net v3" },
        { "choice": "nunit", "description": "NUnit" }
      ]
    },
    "frameworkDisplayName": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "testFramework",
        "steps": [
          { "regex": "^mstest$", "replacement": "MSTest" },
          { "regex": "^xunit$", "replacement": "xUnit" },
          { "regex": "^nunit$", "replacement": "NUnit" }
        ]
      },
      "replaces": "__TEST_FRAMEWORK__"
    },
    "projectName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "__PROJECT__",
      "fileRename": "__PROJECT__"
    },
    "workerIdentity": {
      "type": "generated",
      "generator": "guid",
      "parameters": { "defaultFormat": "n" },
      "replaces": "__WORKER_ID__"
    },
    "namespace": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "safe_namespace"
    },
    "escapedNamespace": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "namespace",
        "steps": [{
          "regex": "(^|\\.)(abstract|as|base|bool|break|byte|case|catch|char|checked|class|const|continue|decimal|default|delegate|do|double|else|enum|event|explicit|extern|false|finally|fixed|float|for|foreach|goto|if|implicit|in|int|interface|internal|is|lock|long|namespace|new|null|object|operator|out|override|params|private|protected|public|readonly|ref|return|sbyte|sealed|short|sizeof|stackalloc|static|string|struct|switch|this|throw|true|try|typeof|uint|ulong|unchecked|unsafe|ushort|using|virtual|void|volatile|while|__arglist|__makeref|__reftype|__refvalue)(?=\\.|$)",
          "replacement": "$1@$2"
        }]
      },
      "replaces": "__NAMESPACE__"
    },
    "snakeName": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "name",
        "steps": [
          { "regex": "([a-z0-9])([A-Z])", "replacement": "$1_$2" },
          { "regex": "([A-Z])([A-Z][a-z])", "replacement": "$1_$2" },
          { "regex": "[^A-Za-z0-9_]", "replacement": "_" },
          { "regex": "^([0-9])", "replacement": "_$1" }
        ]
      }
    },
    "extensionNameParameter": {
      "type": "parameter",
      "datatype": "text",
      "description": "PostgreSQL extension name: 1 to 63 lowercase ASCII letters, digits or underscores (default: the project name in snake_case)"
    },
    "defaultExtensionName": {
      "type": "generated",
      "generator": "casing",
      "parameters": { "source": "snakeName", "toLower": true }
    },
    "selectedExtensionName": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": { "sourceVariableName": "extensionNameParameter", "fallbackVariableName": "defaultExtensionName" }
    },
    "lowerExtensionName": {
      "type": "generated",
      "generator": "casing",
      "parameters": { "source": "selectedExtensionName", "toLower": true }
    },
    "extensionName": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "lowerExtensionName",
        "steps": [
          { "regex": "[^a-z0-9_]", "replacement": "_" },
          { "regex": "^([0-9])", "replacement": "_$1" },
          { "regex": "^(.{63}).+$", "replacement": "$1" }
        ]
      },
      "replaces": "__EXTENSION__"
    },
    "extensionIdentifier": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "extensionName",
        "steps": [{
          "regex": "^(all|analyse|analyze|and|any|array|as|asc|asymmetric|authorization|between|bigint|binary|bit|boolean|both|case|cast|char|character|check|coalesce|collate|collation|column|concurrently|constraint|create|cross|current_catalog|current_date|current_role|current_schema|current_time|current_timestamp|current_user|dec|decimal|default|deferrable|desc|distinct|do|else|end|except|exists|extract|false|fetch|float|for|foreign|freeze|from|full|grant|greatest|group|grouping|having|ilike|in|initially|inner|inout|int|integer|intersect|interval|into|is|isnull|join|json|json_array|json_arrayagg|json_exists|json_object|json_objectagg|json_query|json_scalar|json_serialize|json_table|json_value|lateral|leading|least|left|like|limit|localtime|localtimestamp|merge_action|national|natural|nchar|none|normalize|not|notnull|null|nullif|numeric|offset|on|only|or|order|out|outer|overlaps|overlay|placing|position|precision|primary|real|references|returning|right|row|select|session_user|setof|similar|smallint|some|substring|symmetric|system_user|table|tablesample|then|time|timestamp|to|trailing|treat|trim|true|union|unique|user|using|values|varchar|variadic|verbose|when|where|window|with|xmlattributes|xmlconcat|xmlelement|xmlexists|xmlforest|xmlnamespaces|xmlparse|xmlpi|xmlroot|xmlserialize|xmltable)$",
          "replacement": "\"$1\""
        }]
      },
      "replaces": "__EXTENSION_IDENTIFIER__"
    }
  }
}
