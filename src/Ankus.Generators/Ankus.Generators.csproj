<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Description>C# source generator for PostgreSQL native entry points, conversions, and SQL.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_IncludeAnkusCodeFixesInPackage</TargetsForTfmSpecificContentInPackage>
    <!-- It compiles a runtime file that declares its own usings, as every file of the runtime does. -->
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Ankus.Runtime/CompilerServices/SpiSqlTokenLayout.cs" Link="CompilerServices/SpiSqlTokenLayout.cs" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <ProjectReference Include="../Ankus.CodeFixes/Ankus.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
  <Target Name="_IncludeAnkusCodeFixesInPackage">
    <MSBuild Projects="../Ankus.CodeFixes/Ankus.CodeFixes.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;SelfContained;PublishAot">
      <Output TaskParameter="TargetOutputs" ItemName="_AnkusCodeFixAssembly" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_AnkusCodeFixAssembly)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
</Project>
