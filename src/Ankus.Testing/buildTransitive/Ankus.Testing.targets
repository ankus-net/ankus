<Project>
  <!-- Populate before the SDK hashes runtime options so property changes also
       invalidate an existing test host's runtimeconfig.json. -->
  <Target Name="_ConfigureAnkusTestPostgresSelection"
          BeforeTargets="_GenerateRuntimeConfigurationFilesInputCache">
    <PropertyGroup>
      <_AnkusTestPgConfigPath>$(AnkusPgConfigPath)</_AnkusTestPgConfigPath>
      <!-- Visual Studio's MSBuild runs on .NET Framework, where GetDirectoryName rejects an empty path. -->
      <_AnkusTestPgConfigDirectory Condition="'$(AnkusPgConfigPath)' != ''">$([System.IO.Path]::GetDirectoryName('$(AnkusPgConfigPath)'))</_AnkusTestPgConfigDirectory>
      <_AnkusTestPgConfigPath Condition="'$(_AnkusTestPgConfigDirectory)' != ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(AnkusPgConfigPath)'))</_AnkusTestPgConfigPath>
    </PropertyGroup>
    <ItemGroup>
      <RuntimeHostConfigurationOption Include="Ankus.Testing.PostgresMajor" Value="$(AnkusPostgresMajor)"
                                      Condition="'$(AnkusPostgresMajor)' != ''" />
      <RuntimeHostConfigurationOption Include="Ankus.Testing.PgConfigPath" Value="$(_AnkusTestPgConfigPath)"
                                      Condition="'$(AnkusPgConfigPath)' != ''" />
      <RuntimeHostConfigurationOption Include="Ankus.Testing.HomeDirectory"
                                      Value="$([MSBuild]::NormalizePath('$(MSBuildStartupDirectory)', '$(ANKUS_HOME)'))"
                                      Condition="'$(ANKUS_HOME)' != ''" />
    </ItemGroup>
  </Target>
</Project>
