<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Ankus.Testing</RootNamespace>
    <Description>Cross-platform PostgreSQL extension test harness for Ankus.</Description>
    <!-- An editor compiles a navigated file on its own, so each file declares its usings and the PDB carries the source. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <EmbedAllSources>true</EmbedAllSources>
  </PropertyGroup>

  <ItemGroup>
    <None Update="buildTransitive/Ankus.Testing.targets" Pack="true" PackagePath="buildTransitive/Ankus.Testing.targets" />
    <PackageReference Include="Npgsql" />
    <ProjectReference Include="../Ankus.PgConfig/Ankus.PgConfig.csproj" />
    <ProjectReference Include="../Ankus.Runtime/Ankus.Runtime.csproj" />
  </ItemGroup>

</Project>
