<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A native library named for its extension version so versions install side by side.</Description>
    <AnkusExtensionName>ankus_versioned_so</AnkusExtensionName>
    <AnkusVersionedLibrary>true</AnkusVersionedLibrary>
    <AnkusExtensionControlFile>$(MSBuildProjectDirectory)/ankus_versioned_so.control</AnkusExtensionControlFile>
  </PropertyGroup>

  <Import Project="../../src/Ankus.Sdk/Ankus.Sdk.targets" />

</Project>
