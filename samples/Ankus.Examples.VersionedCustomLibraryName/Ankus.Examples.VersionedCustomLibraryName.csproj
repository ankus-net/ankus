<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A custom native library name combined with versioned libraries.</Description>
    <AnkusLibraryName>versioned_othername</AnkusLibraryName>
    <AnkusExtensionName>ankus_versioned_custom_libname_so</AnkusExtensionName>
    <AnkusVersionedLibrary>true</AnkusVersionedLibrary>
    <AnkusExtensionControlFile>$(MSBuildProjectDirectory)/ankus_versioned_custom_libname_so.control</AnkusExtensionControlFile>
  </PropertyGroup>

  <Import Project="../../src/Ankus.Sdk/Ankus.Sdk.targets" />

</Project>
